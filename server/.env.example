# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/gokul-hrm
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gokul-hrm?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/gokul-hrm

# Port the Express API listens on (hosting platforms set this automatically)
PORT=5000

# development | production
NODE_ENV=development

# Secret used to sign JWTs. Must be 32+ characters in production
# (e.g. `openssl rand -hex 32`). Never reuse this across environments.
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated list of origins allowed to call this API
# Production example: https://gokul-hrm.vercel.app
CORS_ORIGIN=http://localhost:5180

# Optional: on startup, if no Admin exists yet, one is created from these.
# Remove ADMIN_PASSWORD from the environment after the first successful boot.
# ADMIN_EMAIL=admin@yourcompany.com
# ADMIN_PASSWORD=choose-a-strong-password
